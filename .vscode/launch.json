{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 → pick an environment → runs with variables.<env>.env loaded.
      // The env file is the SINGLE source of truth: it supplies
      //   ConnectionStrings__DefaultConnection, Auth__* secrets,
      //   ASPNETCORE_ENVIRONMENT and ASPNETCORE_URLS.
      "name": "Launch Battleship",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/GpBattleshipWebapp/bin/Debug/net10.0/GpBattleshipWebapp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/GpBattleshipWebapp",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/variables.${input:environment}.env",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/GpBattleshipWebapp/Views"
      }
    },
    {
      // Same environment picker, but with hot reload (dotnet watch).
      "name": "Launch Battleship (Watch / hot reload)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "watch",
      "program": "${workspaceFolder}/src/GpBattleshipWebapp/bin/Debug/net10.0/GpBattleshipWebapp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/GpBattleshipWebapp",
      "stopAtEntry": false,
      "envFile": "${workspaceFolder}/variables.${input:environment}.env",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": [],
  "inputs": [
    {
      "id": "environment",
      "description": "Select Environment",
      "type": "pickString",
      "options": [
        "Development",
        "QA",
        "Production",
        "Development.local"
      ],
      "default": "Development.local"
    }
  ]
}
